# Copy this file to .env and fill in your local MySQL password.
# The API reads every name below. The React app only receives names that start with VITE_.
# On a phone (same Wi-Fi), set VITE_API_BASE_URL to http://YOUR_PC_IP:4000/api

# ----- MySQL -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=parking
MYSQL_USER=root
MYSQL_PASSWORD=
DB_CREATE_AND_SEED=true

# ----- API -----
ASPNETCORE_ENVIRONMENT=Development
API_PORT=4000
ASPNETCORE_URLS=http://0.0.0.0:4000
CORS_ORIGINS=*

# JWT secret must be at least 32 characters
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7

# ----- Mobile web app (Vite) -----
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=Smart Parking
VITE_APP_TAGLINE=Smart Parking Slot Booking and Management System
VITE_TOKEN_STORAGE_KEY=sp_token
VITE_USER_STORAGE_KEY=sp_user
VITE_CURRENCY_LABEL=Rs.
VITE_CURRENCY_CODE=NPR
VITE_DEFAULT_PAYMENT_METHOD=esewa
VITE_PAYMENT_METHODS=esewa,khalti,card
VITE_BOOKING_LEAD_MINUTES=10
VITE_BOOKING_DURATION_HOURS=2
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
