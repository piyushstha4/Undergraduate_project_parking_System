<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartParking.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MySQL driver (works with MySQL 8 and MariaDB / XAMPP) -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <!-- Lightweight SQL-to-object mapper -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- Password hashing (same algorithm as the old Node bcryptjs backend) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- JWT bearer authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- Swagger UI at /swagger for testing the API -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schema is executed on startup by DbInitializer -->
    <None Update="Data\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
